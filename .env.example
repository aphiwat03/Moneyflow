# Local Docker PostgreSQL (start with: npm run db:up)
DATABASE_URL="postgresql://moneyflow:moneyflow_local_pw@localhost:5433/moneyflow"

# Optional: Cloud PostgreSQL (Neon) if deploying online
# DATABASE_URL="postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/moneyflow?sslmode=require"

# Auth.js v5 secret — generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional: Google OAuth for one-click sign-in
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Auth.js reverse proxy trust (enable when exposing Next.js via Cloudflare Tunnel)
AUTH_TRUST_HOST="true"

# Local e-Slip OCR worker (OpenThai2.1-OCR-Text-20261118 v2.1.4)
OCR_WORKER_URL="http://127.0.0.1:8001"
SLIP_OCR_PROVIDER="local"

# Optional: Gemini API for future cloud OCR upgrade (currently mocked when provider="gemini")
GEMINI_API_KEY=""
