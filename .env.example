# Local Docker PostgreSQL (start with: npm run db:up)
DATABASE_URL="postgresql://moneyflow:moneyflow_local_pw@localhost:5433/moneyflow"

# Cloud PostgreSQL (Neon): MUST use the "-pooler" endpoint with sslmode=require on Vercel Serverless
# DATABASE_URL="postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/moneyflow?sslmode=require"

# Auth.js v5 secret — generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional: Google OAuth for one-click sign-in
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Auth.js reverse proxy trust (enable when deploying behind Vercel/Cloudflare Tunnel/reverse proxy)
AUTH_TRUST_HOST="true"

# Cloud Access Control (recommended for personal/family deployments on Cloud)
# Set ALLOW_PUBLIC_REGISTRATION="false" to close open sign-ups on Cloud
ALLOW_PUBLIC_REGISTRATION="true"
# Optional: set an invite code to allow sign-ups only with a matching code on /register
REGISTRATION_INVITE_CODE=""
# Optional: comma-separated allowlist of emails permitted for registration & Google OAuth
ALLOWED_AUTH_EMAILS=""

# Local e-Slip OCR worker (OpenThai2.1-OCR-Text-20261118 v2.1.4)
OCR_WORKER_URL="http://127.0.0.1:8001"
# Shared secret sent as X-OCR-API-KEY (REQUIRED if exposing OCR worker over Cloudflare Tunnel)
OCR_SHARED_SECRET=""
SLIP_OCR_PROVIDER="local"

# Optional: Gemini API for future cloud OCR upgrade (currently mocked when provider="gemini")
GEMINI_API_KEY=""
